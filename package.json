{
  "name": "digital-legacy-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Legacy Vault — secure digital estate vault (monorepo)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
