      "800": { "$type": "color", "$value": "#224C77" },
      "900": { "$type": "color", "$value": "#1E4062" },
      "950": { "$type": "color", "$value": "#1D3049" }
    },
    "green": { "400": { "$type": "color", "$value": "#4CC38A" }, "600": { "$type": "color", "$value": "#1B7F4D" } },
    "amber": { "400": { "$type": "color", "$value": "#E5A13D" }, "600": { "$type": "color", "$value": "#A15C07" } },
