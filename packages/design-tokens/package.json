{
  "name": "@dlv/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens (W3C DTCG source, Tailwind 4 @theme, typed TS values) for Digital Legacy Vault.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["*.css"],
  "engines": { "node": ">=22.0.0" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./theme.css": "./theme.css",
    "./tokens.json": "./src/tokens.dtcg.json"
  },
  "files": ["dist", "theme.css", "src/tokens.dtcg.json"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@dlv/eslint-config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.27.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.4"
  }
}
