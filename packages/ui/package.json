{
  "name": "@dlv/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Legacy Vault React component library (design-system foundations: tokens, buttons, inputs, shell).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.0.0" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@dlv/design-tokens": "workspace:*",
    "@dlv/eslint-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.27.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.4"
  }
}
