{
  "name": "@dlv/config",
  "version": "0.1.0",
  "private": true,
  "description": "Zod-validated environment loading for Digital Legacy Vault (single aggregated error, secret-safe messages, .env.example generator).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dlv/eslint-config": "workspace:*",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.27.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.4"
  }
}
