# Digital Legacy Vault — environment template
# Copy to .env and fill in the placeholders. NEVER commit a real .env;
# in cloud environments all secrets come from AWS Secrets Manager
# (PROJECT_MEMORY §7.7).

# One of: development | test | staging | production.
NODE_ENV=development

# API listen port.
API_PORT=4000

# PostgreSQL connection URL (matches docker-compose defaults).
DATABASE_URL=postgresql://dlv:dlv@localhost:5432/dlv?schema=public

# Redis connection URL (sessions, cache, queues, rate limiting).
REDIS_URL=redis://localhost:6379

# RS256 private key, PEM. Generate locally: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048. Cloud: AWS Secrets Manager only.
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# RS256 public key, PEM (served via JWKS).
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# JWT iss claim.
JWT_ISSUER=https://dlv.stellr-net.com

# JWT aud claim.
JWT_AUDIENCE=dlv-api

# Access-token TTL in seconds (15 min).
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh-token absolute TTL in seconds (30 days).
REFRESH_TOKEN_TTL_SECONDS=2592000

# 32-byte AES-256 field-encryption key, standard base64. Generate: openssl rand -base64 32. Local/dev only — KMS in cloud.
FIELD_ENCRYPTION_KEY_B64=<openssl rand -base64 32>

# WebAuthn relying-party ID (registrable domain of the web app).
WEBAUTHN_RP_ID=localhost

# WebAuthn expected origin (scheme + host + port of the web app).
WEBAUTHN_ORIGIN=http://localhost:3000

# Domain attribute for auth cookies (dlv_rt).
COOKIE_DOMAIN=localhost

# Public base URL of the web app (email links, redirects).
WEB_BASE_URL=http://localhost:3000
