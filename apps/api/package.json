{
  "name": "@dlv/api",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Legacy Vault \u2014 NestJS 11 API (Phase 2: identity bounded context)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1140.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/client-textract": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@casl/ability": "^6.7.3",
    "@dlv/config": "workspace:*",
    "@dlv/crypto": "workspace:*",
    "@dlv/shared-types": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.2.1",
    "@simplewebauthn/server": "^13.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@dlv/eslint-config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "typescript": "^5.7.3"
  }
