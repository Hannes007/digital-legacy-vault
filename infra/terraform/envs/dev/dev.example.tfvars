# =============================================================================
# envs/dev — example variables. Copy to dev.tfvars and fill in.
# NO SECRETS HERE (invariant §7.7): DB/Redis credentials are generated by
# Terraform and stored in Secrets Manager, never in tfvars.
# =============================================================================

aws_region         = "af-south-1"
vpc_cidr           = "10.10.0.0/16"
kubernetes_version = "1.30"

# Restrict the EKS public API endpoint to admin + CI egress CIDRs (never 0.0.0.0/0).
eks_public_access_cidrs = ["203.0.113.10/32"]

# ARNs that may administer the data CMK (e.g. the platform-admin SSO role).
key_admin_arns = ["arn:aws:iam::123456789012:role/dlv-platform-admin"]

# Usually empty — CMK use is granted via IAM policies / service grants.
key_user_arns = []

# Short Object Lock retention in dev so the stack can be torn down; prod ~2555.
documents_object_lock_days = 1
